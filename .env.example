# ── Supabase (leads, order requests, AI consultations, catalog) ──
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── AI Lighting Studio ──
# With a key set, /api/analyze reads uploaded photos with Claude
# vision. Without it, the studio runs in demo mode (deterministic
# plans by room type) so the site always works.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=

# ── Commerce (future) ──
# Order requests are captured in Supabase today; connect Shopify
# (Storefront API) or Stripe here when ready to take payment.
# SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_STORE_DOMAIN=
