# ── Supabase (catalog mirror, orders, inventory, CRM, captures) ──
# Create a project, run supabase/schema.sql then supabase/seed.sql,
# then copy the URL + keys from Project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by the Stripe webhook + staff console. NEVER
# expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (payments) ──
# Without a key, checkout gracefully captures order requests
# instead of taking payment. With keys set, /api/checkout creates
# Stripe Checkout sessions and /api/stripe-webhook records orders,
# decrements inventory, and upserts CRM customers.
# Webhook endpoint to register: https://<your-domain>/api/stripe-webhook
# (event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Staff console (/admin) ──
# Unset = open demo mode with sample data. Set a strong password
# before deploying anywhere public.
ADMIN_PASSWORD=
